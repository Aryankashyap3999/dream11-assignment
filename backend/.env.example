# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:<custom_password>@localhost:5434/<db_name>"

# AI provider (explicit; the key is generic). Supported: gemini, groq
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
REPLAY_INTERVAL_MS=2000
