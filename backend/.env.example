# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:<custom_password>@localhost:5434/<db_name>"

# AI provider (explicit; the key is generic). Supported: gemini, groq
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
REPLAY_INTERVAL_MS=2000

# Comma-separated frontend origin(s) allowed by CORS, e.g. https://your-app.vercel.app. Unset = any origin (local dev).
FRONTEND_ORIGIN=
# Max AI requests per IP per minute (default 20)
AI_RATE_LIMIT_PER_MIN=20
